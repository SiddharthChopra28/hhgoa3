{
  "name": "faceid-provenance",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "run:cli": "pnpm --filter web run:cli",
    "face:dev": "cd services/face && uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "contracts:test": "cd contracts && forge test",
    "contracts:export-abi": "cd contracts && ./export-abi.sh"
  }
}
