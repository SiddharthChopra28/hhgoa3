# Copy to .env at the repo root. apps/web and services/face both read this file.

# --- Face service (services/face) ---
FACE_SERVICE_URL=http://localhost:8000
FACE_SIMILARITY_THRESHOLD=0.5
FACE_SERVICE_TIMEOUT_MS=20000
# Python side (services/face)
FACE_DET_SIZE=640
FACE_CTX_ID=-1
FACE_FETCH_TIMEOUT_S=15
FACE_MAX_IMAGE_BYTES=10485760

# --- Reverse image search ---
SERPAPI_API_KEY=
TINEYE_API_KEY=
SEARCH_TIMEOUT_MS=30000

# --- Temporary public hosting (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Chain ---
# arbitrum-sepolia | arbitrum-one
CHAIN=arbitrum-sepolia
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc
PRIVATE_KEY=
# Optional override of the address exported in apps/web/lib/contract.ts
FACE_MATCH_REGISTRY_ADDRESS=
MAX_FEE_PER_GAS_GWEI=1
TX_RECEIPT_TIMEOUT_MS=90000
# Used by `forge script --verify` and `forge verify-contract`
ARBISCAN_API_KEY=

# --- Limits ---
MAX_UPLOAD_BYTES=5242880
MAX_CANDIDATES=15
