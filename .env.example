# ── Search ─────────────────────────────────────────────────────────────
# SerpApi key (free tier = 250 searches/month). Used for Google Lens + Yandex.
SERPAPI_API_KEY=

# ── Temporary image hosting (free, no-auth defaults) ────────────────────
# Which host to use for the public copy of the uploaded image.
# catbox (default) or tmpfiles. Both are free and anonymous.
IMAGE_HOST=catbox

# ── Blockchain ──────────────────────────────────────────────────────────
# Local anvil chain (see README) or a public testnet.
# Local anvil defaults: RPC_URL=http://127.0.0.1:8545  CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Signing key. For local anvil use one of the pre-funded accounts, e.g.
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=

# If set, skip deployment and use this already-deployed contract address.
# CONTRACT_ADDRESS=

# Set to false to run face+search+verify without writing to the chain.
ENABLE_CHAIN=true

# ── Tuning ─────────────────────────────────────────────────────────────
FACE_SIMILARITY_THRESHOLD=0.5
FACE_DETECT_MIN_CONFIDENCE=0.4
MAX_PERCEPTUAL_DISTANCE=12
MAX_CANDIDATES=15

# ── Optional UI ────────────────────────────────────────────────────────
PORT=3000

# ── Smoke-test fixture (DO NOT set for a real run) ──────────────────────
# If set, reverse-image search is replaced with this single fixed URL, so the
# whole pipeline (face -> verify -> chain) can be exercised without a search key.
# MOCK_SEARCH_URL=
